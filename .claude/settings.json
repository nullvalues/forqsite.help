{
  "permissions": {
    "deny": [
      "Edit(docs/phases/permissions/**)",
      "Write(docs/phases/permissions/**)"
    ],
    "allow": [
      "Bash(PATH=$HOME/.local/bin:$PATH uv run python /mnt/work/flex/skills/pairmode/scripts/flex_build.py permissions-create *)",
      "Bash(PATH=$HOME/.local/bin:$PATH uv run python /mnt/work/flex/skills/pairmode/scripts/flex_build.py write-permissions *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Task|Agent|Edit|Write|Read",
        "hooks": [
          {
            "type": "command",
            "command": "uv run python /mnt/work/flex/hooks/pre_tool_use.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run python /mnt/work/flex/hooks/user_prompt_submit.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run python /mnt/work/flex/hooks/session_start.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "uv run python /mnt/work/flex/hooks/post_tool_use.py"
          }
        ]
      }
    ]
  }
}
